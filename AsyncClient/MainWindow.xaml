<Window x:Class="AsyncClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AsyncClient"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="560"
        MinHeight="560"
        Width="700">
    <Grid>
        <TextBox x:Name="FNameBox"
                 HorizontalAlignment="Left"
                 Margin="250,40,0,0"
                 VerticalAlignment="Top"
                 Width="180"
                 Text="FirstName"/>

        <TextBox x:Name="LNameBox"
                 HorizontalAlignment="Left"
                 Margin="250,75,0,0"
                 VerticalAlignment="Top"
                 Width="180"
                 Text="LastName"/>

        <TextBox x:Name="AcctNoBox"
                 HorizontalAlignment="Left"
                 Margin="250,110,0,0"
                 VerticalAlignment="Top"
                 Width="180"
                 Text="AcctNo"/>

        <TextBox x:Name="PinBox"
                 HorizontalAlignment="Left"
                 Margin="250,145,0,0"
                 VerticalAlignment="Top"
                 Width="180"
                 Text="Pin"/>

        <TextBox x:Name="BalanceBox"
                 HorizontalAlignment="Left"
                 Margin="250,180,0,0"
                 VerticalAlignment="Top"
                 Width="180"
                 Text="Balance"/>

        <TextBox x:Name="IndexNum"
                 HorizontalAlignment="Left"
                 Margin="210,270,0,0"
                 VerticalAlignment="Top"
                 Width="100"
                 Text="Index"/>

        <Button x:Name="GoButton"
                Content="Go!"
                HorizontalAlignment="Left"
                Margin="360,270,0,0"
                VerticalAlignment="Top"
                Width="100"
                Click="GoButton_Click"/>

        <TextBlock Text="Total Items:"
                   HorizontalAlignment="Left"
                   Margin="210,315,0,0"
                   VerticalAlignment="Top"/>

        <TextBlock x:Name="TotalNum"
                   HorizontalAlignment="Left"
                   Margin="290,315,0,0"
                   VerticalAlignment="Top"
                   Width="100"/>

        <Image x:Name="ProfileImage"
               HorizontalAlignment="Left"
               Margin="500,40,0,0"
               VerticalAlignment="Top"
               Width="180"
               Height="180"
               Stretch="UniformToFill"/>

        <!-- Search by last name -->
        <TextBox x:Name="SearchLastNameBox"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="210,360,0,0"
                 Width="100"
                 Height="25"
                 Text="Last Name"/>

        <Button x:Name="SearchButton"
				Content="Search"
                HorizontalAlignment="Left"
                Margin="360,360,0,0"
                VerticalAlignment="Top"
                Width="100"
                Height="25"
                Click="SearchButton_Click"/>

        <!-- Shows that a search is currently running -->
        <ProgressBar x:Name="SearchProgressBar"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="210,400,0,0"
                     Width="250"
                     Height="20"
                     IsIndeterminate="False"/>
    </Grid>
</Window>
